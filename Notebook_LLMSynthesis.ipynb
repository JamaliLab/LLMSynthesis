{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "eb8b7758",
   "metadata": {},
   "source": [
    "# Figure 1 — plate heatmaps of LSPR peak wavelength\n",
    "\n",
    "Reads `plate_spectra.xlsx` (one tab per run, absorbance only), computes the peak\n",
    "wavelength for every well, and draws all five plates as a single row of heatmaps\n",
    "sharing **one universal colorbar**."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "34eef7f6",
   "metadata": {},
   "source": [
    "## 1. Settings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "95c8d02d",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_FILE = \"plate_spectra.xlsx\"   # path to the spectra workbook\n",
    "\n",
    "# Peak-search window (nm). The maximum absorbance is located inside this window.\n",
    "WIN_LO, WIN_HI = 500, 900\n",
    "\n",
    "CMAP  = \"turbo\"     # colormap shared by every panel\n",
    "TICK_STEP = 50      # colorbar tick spacing, nm\n",
    "\n",
    "# Set these to override the automatic scale, e.g. VMIN, VMAX = 500, 900\n",
    "VMIN = VMAX = None\n",
    "\n",
    "SAVE_AS = \"Figure1_heatmaps\"      # writes .pdf and .png; set to None to skip\n",
    "DPI = 400"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ad38d950",
   "metadata": {},
   "source": [
    "## 2. Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ebea5b32",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib as mpl\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import Normalize\n",
    "\n",
    "# use Arial if installed, else the closest metric-compatible fallback\n",
    "from matplotlib import font_manager\n",
    "_installed = {f.name for f in font_manager.fontManager.ttflist}\n",
    "mpl.rcParams[\"font.family\"] = next(\n",
    "    (f for f in [\"Arial\", \"Helvetica\", \"Liberation Sans\", \"DejaVu Sans\"] if f in _installed),\n",
    "    \"sans-serif\")\n",
    "\n",
    "mpl.rcParams[\"pdf.fonttype\"] = 42   \n",
    "mpl.rcParams[\"svg.fonttype\"] = \"none\"\n",
    "\n",
    "PLATE_ROWS = list(\"ABCDEFGH\")\n",
    "PLATE_COLS = list(range(1, 13))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fb500711",
   "metadata": {},
   "source": [
    "## 3. Load the tabs\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "04ce5412",
   "metadata": {},
   "outputs": [],
   "source": [
    "xls = pd.ExcelFile(DATA_FILE)\n",
    "\n",
    "run_names = sorted(\n",
    "    [s for s in xls.sheet_names if s.strip().lower().startswith(\"run\")],\n",
    "    key=lambda s: int(\"\".join(ch for ch in s if ch.isdigit()))\n",
    ")\n",
    "\n",
    "spectra = {r: pd.read_excel(xls, sheet_name=r, index_col=0) for r in run_names}\n",
    "\n",
    "for r, df in spectra.items():\n",
    "    print(f\"{r}: {df.shape[0]} wavelengths ({df.index.min():.0f}-{df.index.max():.0f} nm), \"\n",
    "          f\"{df.shape[1]} wells\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c6c61fc8",
   "metadata": {},
   "source": [
    "## 4. Peak wavelength per well\n",
    "\n",
    "`lambda_max` is the wavelength of maximum absorbance inside the search window.\n",
    "\n",
    "A well that returns exactly `WIN_LO` has **no** maximum inside the window — its\n",
    "spectrum falls monotonically from the lower edge. Those are blank / no-LSPR wells\n",
    "rather than a measured 500 nm peak, and they are counted separately below."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "64b6c955",
   "metadata": {},
   "outputs": [],
   "source": [
    "def lambda_max_grid(df, lo=WIN_LO, hi=WIN_HI):\n",
    "    \"\"\"Return an 8x12 array of peak wavelengths laid out as the physical plate.\"\"\"\n",
    "    sub = df.loc[(df.index >= lo) & (df.index <= hi)]\n",
    "    peak = sub.idxmax(axis=0)\n",
    "    return np.array([[peak[f\"{r}{c}\"] for c in PLATE_COLS] for r in PLATE_ROWS],\n",
    "                    dtype=float)\n",
    "\n",
    "grids = {r: lambda_max_grid(df) for r, df in spectra.items()}\n",
    "\n",
    "summary = pd.DataFrame({\n",
    "    \"min (nm)\":     {r: g.min() for r, g in grids.items()},\n",
    "    \"max (nm)\":     {r: g.max() for r, g in grids.items()},\n",
    "    \"median (nm)\":  {r: np.median(g) for r, g in grids.items()},\n",
    "    \"no peak (=%d)\" % WIN_LO: {r: int((g == WIN_LO).sum()) for r, g in grids.items()},\n",
    "})\n",
    "summary"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e9bb593a",
   "metadata": {},
   "source": [
    "## 5. The universal colour scale\n",
    "\n",
    "Limits are rounded outward to the nearest tick so the bar ends on a labelled value,\n",
    "and an assertion confirms no well falls outside the scale"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "17e1e70f",
   "metadata": {},
   "outputs": [],
   "source": [
    "pooled = np.concatenate([g.ravel() for g in grids.values()])\n",
    "\n",
    "vmin = VMIN if VMIN is not None else np.floor(pooled.min() / TICK_STEP) * TICK_STEP\n",
    "vmax = VMAX if VMAX is not None else np.ceil(pooled.max() / TICK_STEP) * TICK_STEP\n",
    "\n",
    "norm = Normalize(vmin=vmin, vmax=vmax)          \n",
    "cmap = plt.get_cmap(CMAP)\n",
    "ticks = np.arange(vmin, vmax + 1, TICK_STEP)\n",
    "\n",
    "n_clipped = int(((pooled < vmin) | (pooled > vmax)).sum())\n",
    "assert n_clipped == 0, f\"{n_clipped} wells fall outside the colour scale and would be clipped\"\n",
    "\n",
    "print(f\"data range {pooled.min():.0f}-{pooled.max():.0f} nm  ->  \"\n",
    "      f\"colour scale {vmin:.0f}-{vmax:.0f} nm, no wells clipped\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c3e4035c",
   "metadata": {},
   "source": [
    "## 6. Draw the figure\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "140ac87e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def label_colour(value):\n",
    "    \"\"\"Black or white annotation, whichever stays readable on this cell.\"\"\"\n",
    "    r, g, b, _ = cmap(norm(value))\n",
    "    return \"black\" if 0.2126*r + 0.7152*g + 0.0722*b > 0.55 else \"white\"\n",
    "\n",
    "\n",
    "def plot_row(grids, norm, cmap, ticks, cbar_label=\"wavelength (nm)\"):\n",
    "    n = len(grids)\n",
    "    fig = plt.figure(figsize=(2.77 * n, 2.55))\n",
    "\n",
    "    left, right, bottom, top = 0.032, 0.935, 0.175, 0.90\n",
    "    gap = 0.013\n",
    "    pw = (right - left - gap * (n - 1)) / n      \n",
    "\n",
    "    for i, (name, g) in enumerate(grids.items()):\n",
    "        ax = fig.add_axes([left + i * (pw + gap), bottom, pw, top - bottom])\n",
    "        ax.imshow(g, cmap=cmap, norm=norm, aspect=\"auto\", interpolation=\"nearest\")\n",
    "\n",
    "        for r in range(g.shape[0]):\n",
    "            for cc in range(g.shape[1]):\n",
    "                v = g[r, cc]\n",
    "                ax.text(cc, r, f\"{v:.0f}\", ha=\"center\", va=\"center\",\n",
    "                        fontsize=4.6, fontweight=\"bold\", color=label_colour(v))\n",
    "\n",
    "        ax.set_title(name, fontsize=13, pad=7)\n",
    "        ax.set_xticks([0, 3, 6, 9, 11])\n",
    "        ax.set_xticklabels([1, 4, 7, 10, 12], fontsize=7)\n",
    "        ax.set_yticks(range(len(PLATE_ROWS)))\n",
    "        ax.set_yticklabels(PLATE_ROWS, fontsize=7, fontweight=\"bold\")\n",
    "        ax.tick_params(length=2.5, width=0.7, pad=1.5)\n",
    "        ax.set_xlabel(\"Silver Nitrate (AgNO$_3$)\", fontsize=11, labelpad=3)\n",
    "        if i == 0:\n",
    "            ax.set_ylabel(\"Ascorbic Acid (AA)\", fontsize=11, labelpad=3)\n",
    "        for s in ax.spines.values():\n",
    "            s.set_linewidth(1.0)\n",
    "\n",
    "    # --- the single universal colorbar ---\n",
    "    cax = fig.add_axes([right + 0.010, bottom, 0.009, top - bottom])\n",
    "    cb = fig.colorbar(mpl.cm.ScalarMappable(norm=norm, cmap=cmap), cax=cax)\n",
    "    cb.set_ticks(ticks)\n",
    "    cb.ax.set_yticklabels([f\"{t:.0f}\" for t in ticks], fontsize=8)\n",
    "    cb.set_label(cbar_label, fontsize=10, labelpad=5)\n",
    "    cb.outline.set_linewidth(0.8)\n",
    "    cb.ax.tick_params(length=2.5, width=0.7, pad=2)\n",
    "    return fig\n",
    "\n",
    "\n",
    "fig = plot_row(grids, norm, cmap, ticks)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "875691c3",
   "metadata": {},
   "source": [
    "## 7. Save"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0b975843",
   "metadata": {},
   "outputs": [],
   "source": [
    "if SAVE_AS:\n",
    "    fig.savefig(f\"{SAVE_AS}.pdf\")       \n",
    "    fig.savefig(f\"{SAVE_AS}.png\", dpi=DPI)\n",
    "    print(f\"wrote {SAVE_AS}.pdf and {SAVE_AS}.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "692aa9c3",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "# Figure 2 — one plate in detail\n",
    "\n",
    "Four panels for a single run, all computed from the same tab of\n",
    "`plate_spectra.xlsx`:\n",
    "\n",
    "| panel | what it shows |\n",
    "|---|---|\n",
    "| **a** | $\\lambda_{max}$ over the full window — the longitudinal band where one exists, otherwise whatever the transverse band or the baseline puts on top |\n",
    "| **b** | $\\lambda_{max}$ restricted to the longitudinal window. Wells whose value moved between a and b are outlined |\n",
    "| **c** | longitudinal / transverse absorbance ratio, indicating how much of the extinction is rod-like rather than sphere-like |\n",
    "| **d** | the underlying spectra for one row, with both search windows shaded |\n",
    "\n",
    "Panels a and b share one colour scale"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "78c29458",
   "metadata": {},
   "source": [
    "## 8. Figure 2 settings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dfe399af",
   "metadata": {},
   "outputs": [],
   "source": [
    "FIG2_RUN = \"Run 4\"            # which tab Figure 2 describes\n",
    "\n",
    "# The two spectral regions. A gold nanorod has a transverse band near 520 nm\n",
    "# (short axis, roughly fixed) and a longitudinal band further red (long axis,\n",
    "# moves with aspect ratio). Panel b and the ratio in panel c both rely on\n",
    "# separating them.\n",
    "TRANSVERSE   = (500, 580)\n",
    "LONGITUDINAL = (600, 900)\n",
    "\n",
    "RATIO_CMAP   = \"RdBu_r\"       # diverging: below 1 blue, above 1 red\n",
    "RATIO_CENTER = 1.0            # ratio = 1 means the two bands are equal\n",
    "\n",
    "# Panel d: which spectra to draw, and which to dash as flagged.\n",
    WATERFALL_WELLS = [f"H{c}" for c in range(1, 13)]
    WATERFALL_DASHED = ["H11", "H12"]
    "WATERFALL_XLIM   = (420, 960)\n",
    "WATERFALL_CMAP   = \"viridis\"\n",
    "\n",
    "# Which cells get outlined in panel b:\n",
    "#   \"changed\"   - every well whose lambda_max moved between the two windows\n",
    "#   \"real-swap\" - only wells that actually have a longitudinal band (ratio >= 1),\n",
    "#                 i.e. genuine band swaps, leaving the no-band wells unmarked\n",
    "OUTLINE = \"changed\"\n",
    "\n",
    "SAVE_AS_FIG2 = \"Figure2_panels\"    # writes .pdf and .png; None to skip"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b18c6f6c",
   "metadata": {},
   "source": [
    "## 9. The two Figure 2 metrics\n",
    "\n",
    "`lambda_max_grid` from section 4 is reused with different windows — panel a is\n",
    "the full window, panel b the longitudinal one.\n",
    "\n",
    "The ratio is peak absorbance in the longitudinal window divided by peak\n",
    "absorbance in the transverse window. Above 1 the rod-like band dominates;\n",
    "below 1 the well is mostly spheres, unreacted salt, or nothing at all."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4c7e021f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ratio_grid(df, trans=TRANSVERSE, longi=LONGITUDINAL):\n",
    "    \"\"\"Longitudinal / transverse peak absorbance, as an 8x12 plate array.\"\"\"\n",
    "    wl = df.index.values.astype(float)\n",
    "    mT = (wl >= trans[0]) & (wl <= trans[1])\n",
    "    mL = (wl >= longi[0]) & (wl <= longi[1])\n",
    "    return np.array([[df[f\"{r}{c}\"].values[mL].max() / df[f\"{r}{c}\"].values[mT].max()\n",
    "                      for c in PLATE_COLS] for r in PLATE_ROWS])\n",
    "\n",
    "\n",
    "df2 = spectra[FIG2_RUN]\n",
    "\n",
    "g_full = lambda_max_grid(df2, WIN_LO, WIN_HI)                  # panel a\n",
    "g_long = lambda_max_grid(df2, LONGITUDINAL[0], LONGITUDINAL[1])  # panel b\n",
    "g_ratio = ratio_grid(df2)                                       # panel c\n",
    "\n",
    "moved = g_full != g_long\n",
    "if OUTLINE == \"real-swap\":\n",
    "    moved = moved & (ratio_grid(df2) >= RATIO_CENTER)\n",
    "\n",
    "# one colour scale for panels a and b, built from both so neither is clipped\n",
    "pooled2 = np.concatenate([g_full.ravel(), g_long.ravel()])\n",
    "v2min = np.floor(pooled2.min() / TICK_STEP) * TICK_STEP\n",
    "v2max = np.ceil(pooled2.max() / TICK_STEP) * TICK_STEP\n",
    "norm2 = Normalize(vmin=v2min, vmax=v2max)\n",
    "ticks2 = np.arange(v2min, v2max + 1, TICK_STEP)\n",
    "\n",
    "assert not ((pooled2 < v2min) | (pooled2 > v2max)).any(), \"panel a/b scale would clip\"\n",
    "\n",
    "print(f\"{FIG2_RUN}: panels a+b share {v2min:.0f}-{v2max:.0f} nm; \"\n",
    "      f\"{(g_full != g_long).sum()} of 96 wells change window to window, \"\n",
    "      f\"{moved.sum()} outlined ({OUTLINE})\")\n",
    "print(f\"ratio range {g_ratio.min():.2f}-{g_ratio.max():.2f}  \"\n",
    "      f\"({(g_ratio >= 1).sum()} wells longitudinal-dominant)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8687a4c3",
   "metadata": {},
   "source": [
    "## 10. Draw Figure 2\n",
    "\n",
    "Panels a–c are annotated plate grids; panel d is the spectra behind them. The\n",
    "outlines in panel b mark every well whose reported peak moved when the\n",
    "transverse band was excluded — those are the wells where panel a was reporting\n",
    "the wrong band."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5fb3e939",
   "metadata": {},
   "outputs": [],
   "source": [
    "from matplotlib.patches import Rectangle\n",
    "from matplotlib.colors import TwoSlopeNorm\n",
    "\n",
    "\n",
    "def _plate_axes(ax, title_letter):\n",
    "    ax.set_xticks([0, 5, 11]); ax.set_xticklabels([1, 6, 12], fontsize=7)\n",
    "    ax.set_yticks(range(8)); ax.set_yticklabels(PLATE_ROWS, fontsize=7, fontweight=\"bold\")\n",
    "    ax.tick_params(length=2.5, width=0.7, pad=1.5)\n",
    "    ax.set_xlabel(\"Silver Nitrate (AgNO$_3$)\", fontsize=9, labelpad=3)\n",
    "    for s in ax.spines.values():\n",
    "        s.set_linewidth(1.0)\n",
    "    ax.text(-0.02, 1.10, title_letter, transform=ax.transAxes,\n",
    "            fontsize=13, fontweight=\"bold\", va=\"top\", ha=\"right\")\n",
    "\n",
    "\n",
    "def annotate(ax, grid, colour_fn, fmt=\"{:.0f}\"):\n",
    "    for r in range(grid.shape[0]):\n",
    "        for c in range(grid.shape[1]):\n",
    "            ax.text(c, r, fmt.format(grid[r, c]), ha=\"center\", va=\"center\",\n",
    "                    fontsize=4.4, fontweight=\"bold\", color=colour_fn(grid[r, c]))\n",
    "\n",
    "\n",
    "def plot_figure2():\n",
    "    fig = plt.figure(figsize=(16.0, 3.05))\n",
    "    bottom, top = 0.20, 0.86\n",
    "    h = top - bottom\n",
    "    pw = 0.148                      # plate panel width\n",
    "    x_a, x_b, x_c, x_d = 0.045, 0.225, 0.470, 0.690\n",
    "\n",
    "    def lum_colour(norm_, cmap_):\n",
    "        def f(v):\n",
    "            r, g, b, _ = cmap_(norm_(v))\n",
    "            return \"black\" if 0.2126*r + 0.7152*g + 0.0722*b > 0.55 else \"white\"\n",
    "        return f\n",
    "\n",
    "    # ---- a) full-window lambda_max ----\n",
    "    ax = fig.add_axes([x_a, bottom, pw, h])\n",
    "    ax.imshow(g_full, cmap=cmap, norm=norm2, aspect=\"auto\", interpolation=\"nearest\")\n",
    "    annotate(ax, g_full, lum_colour(norm2, cmap))\n",
    "    _plate_axes(ax, \"a)\")\n",
    "    ax.set_ylabel(\"Ascorbic Acid (AA)\", fontsize=9, labelpad=3)\n",
    "\n",
    "    # ---- b) longitudinal-window lambda_max ----\n",
    "    ax = fig.add_axes([x_b, bottom, pw, h])\n",
    "    ax.imshow(g_long, cmap=cmap, norm=norm2, aspect=\"auto\", interpolation=\"nearest\")\n",
    "    annotate(ax, g_long, lum_colour(norm2, cmap))\n",
    "    for r, c in zip(*np.where(moved)):\n",
    "        ax.add_patch(Rectangle((c-0.5, r-0.5), 1, 1, fill=False,\n",
    "                               edgecolor=\"black\", linewidth=1.4))\n",
    "    _plate_axes(ax, \"b)\")\n",
    "    ax.set_ylabel(\"Ascorbic Acid (AA)\", fontsize=9, labelpad=3)\n",
    "\n",
    "    cax = fig.add_axes([x_b + pw + 0.011, bottom, 0.007, h])\n",
    "    cb = fig.colorbar(mpl.cm.ScalarMappable(norm=norm2, cmap=cmap), cax=cax)\n",
    "    cb.set_ticks(ticks2); cb.ax.set_yticklabels([f\"{t:.0f}\" for t in ticks2], fontsize=7)\n",
    "    cb.set_label(\"wavelength (nm)\", fontsize=8, labelpad=4)\n",
    "    cb.outline.set_linewidth(0.8); cb.ax.tick_params(length=2.5, width=0.7, pad=2)\n",
    "\n",
    "    # ---- c) longitudinal / transverse ratio ----\n",
    "    rnorm = TwoSlopeNorm(vmin=min(g_ratio.min(), RATIO_CENTER - 0.01),\n",
    "                         vcenter=RATIO_CENTER, vmax=g_ratio.max())\n",
    "    rcmap = plt.get_cmap(RATIO_CMAP)\n",
    "    ax = fig.add_axes([x_c, bottom, pw, h])\n",
    "    ax.imshow(g_ratio, cmap=rcmap, norm=rnorm, aspect=\"auto\", interpolation=\"nearest\")\n",
    "    annotate(ax, g_ratio, lum_colour(rnorm, rcmap), fmt=\"{:.1f}\")\n",
    "    _plate_axes(ax, \"c)\")\n",
    "    ax.set_ylabel(\"Ascorbic Acid (AA)\", fontsize=9, labelpad=3)\n",
    "\n",
    "    cax = fig.add_axes([x_c + pw + 0.011, bottom, 0.007, h])\n",
    "    cb = fig.colorbar(mpl.cm.ScalarMappable(norm=rnorm, cmap=rcmap), cax=cax)\n",
    "    cb.ax.tick_params(labelsize=7, length=2.5, width=0.7, pad=2)\n",
    "    cb.set_label(\"longitudinal / transverse\", fontsize=8, labelpad=4)\n",
    "    cb.outline.set_linewidth(0.8)\n",
    "\n",
    "    # ---- d) the spectra behind them ----\n",
    "    ax = fig.add_axes([x_d, bottom, 0.275, h])\n",
    "    wl = df2.index.values.astype(float)\n",
    "    m = (wl >= WATERFALL_XLIM[0]) & (wl <= WATERFALL_XLIM[1])\n",
    "    wcmap = plt.get_cmap(WATERFALL_CMAP)\n",
    "    n = len(WATERFALL_WELLS)\n",
    "\n",
    "    ax.axvspan(*TRANSVERSE, color=\"0.55\", alpha=0.30, lw=0, zorder=0)\n",
    "    ax.axvspan(*LONGITUDINAL, color=\"0.80\", alpha=0.45, lw=0, zorder=0)\n",
    "\n",
    "    for i, well in enumerate(WATERFALL_WELLS):\n",
    "        ax.plot(wl[m], df2[well].values[m],\n",
    "                color=wcmap(i / max(n - 1, 1)), lw=1.2, zorder=3,\n",
    "                linestyle=\"--\" if well in WATERFALL_DASHED else \"-\")\n",
    "\n",
    "    ax.set_xlim(*WATERFALL_XLIM)\n",
    "    ax.set_xlabel(\"wavelength (nm)\", fontsize=9, labelpad=3)\n",
    "    ax.set_ylabel(\"absorbance\", fontsize=9, labelpad=3)\n",
    "    ax.tick_params(labelsize=7, length=2.5, width=0.7, pad=2)\n",
    "    for s in ax.spines.values():\n",
    "        s.set_linewidth(1.0)\n",
    "    ax.text(-0.02, 1.10, \"d)\", transform=ax.transAxes,\n",
    "            fontsize=13, fontweight=\"bold\", va=\"top\", ha=\"right\")\n",
    "    return fig\n",
    "\n",
    "\n",
    "fig2 = plot_figure2()\n",
    "plt.show()"
